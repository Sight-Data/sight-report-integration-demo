# 复制本文件为 .env 后填写真实值（.env 已在 .gitignore 中，不会被提交）
# Copy this file to .env and fill in real values (.env is gitignored)

# demo 后端自身监听端口 / Port of this demo backend
PORT=3010

# Sight Report 部署地址 / Sight Report deployment base URL
SIGHT_REPORT_BASE_URL=http://localhost:9090

# 在「系统管理 → 第三方应用」创建应用后获得
# Created under System → Third-party applications
SIGHT_REPORT_APP_ID=erp-system
SIGHT_REPORT_APP_SECRET=replace-with-real-secret

# 签名有效期：默认值与上限（分钟）
# Signature lifetime: default and maximum, in minutes
DEMO_DEFAULT_EXPIRE_MINUTES=10
DEMO_MAX_EXPIRE_MINUTES=60

# 调用报表系统的超时（毫秒），默认 15000
# Timeout for requests to Sight Report, in ms (default 15000)
# DEMO_UPSTREAM_TIMEOUT_MS=15000

# JSON 请求体上限（暂存数据集上传），默认 10mb
# Max JSON request body (staged dataset uploads), default 10mb
# DEMO_JSON_BODY_LIMIT=10mb
